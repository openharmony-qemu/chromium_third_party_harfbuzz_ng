<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="OFL-1.1-no-RFN" path="test/shape/data/in-house.*" desc="" />
                <policyitem type="compatibility" name="GPL-3.0-or-later" path="m4.*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="m4.*" desc="" />
                <policyitem type="compatibility" name="Keith Packard" path="util.*" desc="" />
                <policyitem type="compatibility" name="Behdad Esfahbod" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="third_party/llvm-10.0/llvm/include/llvm/Support/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Tools/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/bloat/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-10.0/Android.bp"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Headers/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name="docs/usermanual-install-harfbuzz.xml"
                    desc="" />
                <filteritem type="filepath" name="docs/usermanual-integration.xml"
                    desc="" />
                <filteritem type="filepath" name="test/shape/texts/in-house/shaper-arabic/script-arabic/language-urdu/crulp/ligatures/LICENSE"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Keith Packard" desc="">
                <licensetext name="
                 * Copyright © 2002 Keith Packard
            " desc="" />
            </licensematcher>

            <licensematcher name="Behdad Esfahbod" desc="">
                <licensetext name="
                # Copyright 2010,2011,2012,2013 Behdad Esfahbod
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>